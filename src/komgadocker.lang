# ===========================================================================
# Multilingual file for the TOS 7 Docker application "komgadocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Komga"
auth         = "gotson"
version      = "@@VERSION@@"
descript     = "Komga is a media server for comics, manga, bandes dessinees, magazines and eBooks. It scans your library, reads ComicRack/ComicInfo metadata, and serves a web reader with collections, read lists, search, OPDS, Kobo Sync and KOReader Sync. This package runs the official Docker Hub image as a non-root container; the database and your books stay in the application data folder."
release_note = "1. First release: Komga 1.30.0 from Docker Hub, x86_64 + aarch64, non-root."
important    = "First login: admin@example.com / admin - change it immediately in the user settings. Put comics/books in DockerAppData/komgadocker/data; the database and settings live in .../config. Needs DockerEngine; add a registry mirror if Docker Hub is unreachable. Back up config and data before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "Komga"
auth         = "gotson"
version      = "@@VERSION@@"
descript     = "Komga 是一个面向漫画、日漫、欧美漫画、杂志和电子书的媒体服务器。它会扫描书库、读取 ComicRack/ComicInfo 元数据，并提供网页阅读器、收藏、阅读列表、搜索、OPDS、Kobo Sync 与 KOReader Sync。本应用使用 Docker Hub 官方镜像并以非 root 用户运行；数据库与书籍都保存在应用数据目录。"
release_note = "1. 首个版本：Komga 1.30.0，来自 Docker Hub，x86_64 + aarch64 双包，非 root。"
important    = "初始登录：admin@example.com / admin，请立即在用户设置里修改。漫画/书籍放到 DockerAppData/komgadocker/data，数据库与设置保存在 .../config。需要 DockerEngine；无法访问 Docker Hub 时请先配置镜像加速。卸载并删除数据前请备份 config 与 data。应用通过局域网 HTTP 访问。"

[zh-hk]
name         = "Komga"
auth         = "gotson"
version      = "@@VERSION@@"
descript     = "Komga 是一個面向漫畫、日漫、歐美漫畫、雜誌和電子書的媒體伺服器。它會掃描書庫、讀取 ComicRack/ComicInfo 元資料，並提供網頁閱讀器、收藏、閱讀清單、搜尋、OPDS、Kobo Sync 與 KOReader Sync。本應用使用 Docker Hub 官方鏡像並以非 root 使用者運行；資料庫與書籍都保存在應用資料目錄。"
release_note = "1. 首個版本：Komga 1.30.0，來自 Docker Hub，x86_64 + aarch64 雙包，非 root。"
important    = "初始登入：admin@example.com / admin，請立即在使用者設定裡修改。漫畫/書籍放到 DockerAppData/komgadocker/data，資料庫與設定保存在 .../config。需要 DockerEngine；無法存取 Docker Hub 時請先設定鏡像加速。解除安裝並刪除資料前請備份 config 與 data。應用透過局域網 HTTP 存取。"

